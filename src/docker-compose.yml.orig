#version: "3.3"

services:
  db:
    image: pgvector/pgvector:pg16
    container_name: postgres_db
    restart: always
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: news360
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./db/init-db.sh:/docker-entrypoint-initdb.d/01-init-db.sh
      - ./db360.dump:/docker-entrypoint-initdb.d/db360.dump
    expose:
      - "5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d news360"]
      interval: 10s
      timeout: 5s
      retries: 5

  api:
    build:
      context: .
      dockerfile: ./app/Dockerfile
    container_name: fastapi_app
    depends_on:
      db:
        condition: service_healthy
    environment:
      DATABASE_URL: postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD}@db:5432/news360
      HF_TOKEN: ${HF_TOKEN}
    expose:
      - "8000"
    volumes:
      - ./db:/db
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s



  scheduler:
    build:
      context: .
      dockerfile: worker/Dockerfile
    container_name: scheduler_worker
    depends_on:
      db:
        condition: service_healthy
    environment:
      DATABASE_URL: postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD}@db:5432/news360
    volumes:
      - ./db:/db
      - ./hebrew_classifier:/app/hebrew_classifier
    restart: unless-stopped
#    mem_limit: 512m
    cpus: 0.5

  ngrok:
    image: ngrok/ngrok:latest
    container_name: ngrok
    depends_on:
      - api
    command: http api:8000
    environment:
      NGROK_AUTHTOKEN: ${NGROK_AUTHTOKEN}
    ports:
      - "4040:4040"

volumes:
  postgres_data: